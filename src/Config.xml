<?xml version="1.0" encoding="utf-8"?>
<LimitByCraftingSkillModConfig>
  <!-- One toggle per crafting skill. When true, items requiring that skill are restricted by player level. -->
  <!-- Multiplayer: this MVP reads the local Config.xml for each process; keep server/client configs aligned. -->
  <CraftingSkills>
    <Armor>true</Armor>
    <Bows>true</Bows>
    <Handguns>true</Handguns>
    <Shotguns>true</Shotguns>
    <Rifles>true</Rifles>
    <MachineGuns>true</MachineGuns>
    <Explosives>true</Explosives>
    <Blades>true</Blades>
    <Clubs>true</Clubs>
    <Spears>true</Spears>
    <Sledgehammers>true</Sledgehammers>
    <Knuckles>true</Knuckles>
    <HarvestingTools>true</HarvestingTools>
    <RepairTools>true</RepairTools>
    <SalvageTools>true</SalvageTools>
    <!-- Release default: false — opt in to consumable restrictions (ItemActionEat + craftingFood / craftingMedical progression). -->
    <Medical>false</Medical>
    <Food>false</Food>
    <Seeds>true</Seeds>
    <Traps>true</Traps>
    <Robotics>true</Robotics>
    <Workstations>true</Workstations>
    <Vehicles>true</Vehicles>
    <Electrician>true</Electrician>
  </CraftingSkills>
  <!-- If true, writes extra info to the game log (for troubleshooting). Values: true, false -->
  <DebugMode>false</DebugMode>
</LimitByCraftingSkillModConfig>
