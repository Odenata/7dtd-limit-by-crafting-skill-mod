<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LimitByCraftingSkillMod</AssemblyName>
    <RootNamespace>LimitByCraftingSkillMod</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SevenDtdDevToolsDir)' == ''">
    <SevenDtdDevToolsDir>$(MSBuildThisFileDirectory)..\..\7dtd-mod-dev-tools</SevenDtdDevToolsDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(SevenDtdInstallDir)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SevenDtdInstallDir)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SevenDtdInstallDir)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SevenDtdDevToolsDir)\third_party\harmony\lib\net472\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(SevenDtdInstallDir)' == ''">
    <ProjectReference Include="$(SevenDtdDevToolsDir)\mocks\UnityEngine-CoreModule-Mock.csproj" />
    <ProjectReference Include="$(SevenDtdDevToolsDir)\mocks\Assembly-CSharp-Mock.csproj" />
    <Reference Include="0Harmony">
      <HintPath>$(SevenDtdDevToolsDir)\third_party\harmony\lib\net472\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BlockActivateRestrictionPatch.cs" />
    <Compile Include="AddItemToToolbeltRestrictionPatch.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="ClassNameToCraftingSkillMapLoader.cs" />
    <Compile Include="EquipItemRestrictionPatch.cs" />
    <Compile Include="EquipmentRestrictionPatch.cs" />
    <Compile Include="EquipmentStackHandleStackSwapPatch.cs" />
    <Compile Include="GameReflection.cs" />
    <Compile Include="HotbarRestrictionPatch.cs" />
    <Compile Include="InventoryGridRestrictionColorPatches.cs" />
    <Compile Include="ItemActionEntryEquipPatch.cs" />
    <Compile Include="LimitByCraftingSkillLogic.cs" />
    <Compile Include="ModApi.cs" />
    <Compile Include="ModContentRoot.cs" />
    <Compile Include="ModConfig.cs" />
    <Compile Include="ModConfigSnapshot.cs" />
    <Compile Include="ProgressionLevelUpPatch.cs" />
    <Compile Include="RestrictionFeedback.cs" />
    <Compile Include="RestrictionHelper.cs" />
    <Compile Include="RestrictionLabelColor.cs" />
    <Compile Include="ServerConfigSync.cs" />
    <Compile Include="ToolbeltHandleStackSwapPatch.cs" />
    <Compile Include="WorkstationVehicleStackSwapPatches.cs" />
    <Compile Include="ItemActionSpawnVehicleRestrictionPatch.cs" />
    <Compile Include="ItemActionExecuteRestrictionPatch.cs" />
    <Compile Include="VehicleDriveRestrictionPatch.cs" />
    <Compile Include="WorkstationOpenRestrictionPatch.cs" />
    <Compile Include="WorkstationActivationCommandsSafePatch.cs" />
    <Compile Include="WorkstationRestrictionUi.cs" />
    <Compile Include="GUIWindowManagerOpenNameLogPatch.cs" />
    <Compile Include="PopupToolTipDisplayTooltipTextPatch.cs" />
    <Compile Include="GameManagerShowTooltipTintPatch.cs" />
    <Compile Include="PopupToolTipUpdateTintPatch.cs" />
    <None Include="ModInfo.xml" />
    <None Include="Config.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ClassNameToCraftingSkillMap.xml" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="ClassNameToCraftingSkillMap.xml" />
  </ItemGroup>

</Project>
